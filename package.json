{
  "name": "pypc-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official digital platform of the Pakistan Youth Parliamentary Council (PYPC)",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-command.cjs generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma-command.cjs generate",
    "db:push": "node scripts/prisma-command.cjs db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/prisma-command.cjs db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma-command.cjs studio",
    "db:backup": "node scripts/db-backup.js",
    "db:restore-test": "node scripts/db-restore-test.js",
    "db:clean": "node scripts/db-clean.js",
    "check:routes": "node scripts/smoke-routes.mjs",
    "check:auth": "node scripts/check-registration.js",
    "check:theme": "node scripts/check-theme-and-password.js",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:responsive": "node scripts/check-responsive.js",
    "check:health": "node scripts/check-health.js",
    "check:connectivity": "node scripts/check-connectivity.js",
    "check:payments": "node scripts/check-payments-dev.js",
    "check:imun": "node scripts/check-imun-2027.js",
    "check:authz": "node scripts/check-authz.mjs",
    "scan:secrets": "node scripts/check-secrets.js",
    "verify:all": "npm run scan:secrets && npm run typecheck && npm run lint && npm run build",
    "setup": "bash setup.sh",
    "setup:win": "setup.bat",
    "db:clean:ship": "node scripts/db-clean.js --trim-audit --trim-anonymous-ai --reset-chain",
    "check:ai": "node scripts/check-ai-multilingual.js",
    "check:social": "node scripts/check-social.js",
    "check:perf": "node scripts/check-performance.js",
    "check:suites": "node scripts/check-all-suites.js",
    "check:audit-chain": "node scripts/check-audit-chain.mjs",
    "check:partnerships": "node scripts/check-partnerships.mjs",
    "build:impact-report": "node scripts/build-impact-report.mjs",
    "build:og": "python3 scripts/build-og-images.py",
    "check:2fa": "node scripts/check-2fa.mjs",
    "audit:rechain": "node scripts/rechain-audit.mjs",
    "audit:rechain:local": "node scripts/audit-rechain-local.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:import:sqlite": "node scripts/import-sqlite-backup.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.20.0",
    "@types/three": "^0.186.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.11.0",
    "jose": "^5.9.6",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^0.441.0",
    "next": "^14.2.35",
    "nodemailer": "^6.10.1",
    "openai": "^4.67.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "sharp": "^0.35.5",
    "stripe": "^16.12.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.41",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
