# ============================================================
# DATABASE
# Local SQLite remains available through npm database commands.
# Vercel: set DATABASE_URL to the Prisma Postgres connection URL.
# See docs/POSTGRESQL.md.
# ============================================================
DATABASE_URL="file:./dev.db"
# Optional private destination for the one-time SQLite import:
# POSTGRES_DATABASE_URL=""

# ============================================================
# SESSION / AUTH
# Generate secret with: openssl rand -base64 32
# ============================================================
AUTH_SECRET="change_this_to_a_long_random_secret_min_32_chars"
SESSION_COOKIE_NAME="pypc_session"

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ORGANISATION_NAME="Pakistan Youth Parliamentary Council"
NEXT_PUBLIC_ORGANISATION_SHORT_NAME="PYPC"

# ============================================================
# PAYMENTS - STRIPE (international cards)
# ============================================================
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ============================================================
# PAYMENTS - JAZZCASH (Pakistan)
# Get these from your JazzCash merchant account.
# ============================================================
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_MERCHANT_NAME="PYPC"
JAZZCASH_MODE="sandbox"

# ============================================================
# PAYMENTS - EASYPAISA (Pakistan)
# ============================================================
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_MODE="sandbox"

# ============================================================
# OPENAI - AI ASSISTANT
# Leave blank: assistant automatically answers from the internal
# PYPC knowledge base instead of calling OpenAI.
# ============================================================
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ============================================================
# EMAIL (optional - used for notifications when configured)
# ============================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="PYPC Secretariat <pypcofficial@gmail.com>"

# ---------------------------------------------------------------------------
# Public contact channels — shown on the site, in the footer and in emails.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL_1="pypcofficial@gmail.com"
NEXT_PUBLIC_CONTACT_EMAIL_2="officialpypc@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE="+92 315 5729598"

# Official social accounts.
#
# All four are compiled into lib/social.ts with the council's own handle
# (pypcofficial): LinkedIn company page, Instagram, Facebook and YouTube. These
# variables are for MOVING a channel to a different address, not for enabling
# one — leave them empty and the compiled defaults are used everywhere (footer,
# contact page, header menus, side rail, AI assistant, structured data).
# Both are compiled in (lib/social.ts). Set them only to move to a different page.
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
# Set to "true" to render a channel as a labelled chip instead of a link (use it
# if a page is ever unreachable). Empty = every channel renders as a link.
NEXT_PUBLIC_SOCIAL_YOUTUBE_PENDING=""

# AI assistant limits.
# One visitor (per browser session) and one address are limited separately, so a
# shared campus connection does not lock out everyone behind it. Validation is
# checked before the limiter, so a typo never costs a question.
AI_RATE_LIMIT_SESSION="25"
AI_RATE_LIMIT_IP="60"
AI_RATE_LIMIT_WINDOW_SECONDS="600"
# Verification scripts only. When set (16+ characters), a request repeating this
# value in the x-pypc-audit header skips the limiter. Leave empty in production.
AI_AUDIT_BYPASS_TOKEN=""

# ---------------------------------------------------------------------------
# CUSTOM DOMAIN
# ---------------------------------------------------------------------------
# Set the public address of the deployment here (used for canonical URLs,
# Open Graph tags, sitemap entries and the structured data). Changing it here is
# all that is needed once DNS points at the host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# ERROR MONITORING (optional)
# ---------------------------------------------------------------------------
# Errors are always logged locally. Add a Sentry DSN and they are also forwarded
# to it — no SDK, no extra bundle, personal data scrubbed. Leave empty to keep
# everything local.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ---------------------------------------------------------------------------
# ANALYTICS (optional)
# ---------------------------------------------------------------------------
# Both are opt-in: with a key set the tag loads, without one nothing is fetched
# and no cookie is set. GA4 is Google Analytics 4, CLARITY is Microsoft Clarity.
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# Framing policy. Defaults to "https:" so the site can be embedded (preview panes,
# partner portals). Restrict to named hosts if you prefer:
#   FRAME_ANCESTORS="'self' https://portal.example.org"
FRAME_ANCESTORS="https:"

# ============================================================
# PAYMENT SIMULATION
# "true" lets you complete the full membership checkout flow
# locally without real merchant credentials. MUST be "false"
# in production.
# ============================================================
PAYMENTS_SIMULATION_MODE="true"

# EMAIL DELIVERY
# When SMTP_* is empty, mail is stored in the outbox.
# EMAIL_DEV_MODE="true" shows the verification code on screen when SMTP is not
# configured. It is a LOCAL TESTING convenience only: you MUST leave it "false"
# on any deployment that real people sign up to. With SMTP configured it has no
# effect at all.
EMAIL_DEV_MODE="false"

# ── Round 7: form protection, audit chain and analytics opt-ins ─────────────
# Secret used to sign the self-hosted human check on public forms. Falls back to
# AUTH_SECRET when unset; set it explicitly in production so the two are
# independent. Changing it only invalidates challenges that are already open.
HUMAN_CHECK_SECRET=""

# Key for the tamper-evident audit chain (SHA-256 over every log entry). Falls
# back to AUTH_SECRET when unset. Never rotate this without exporting the log
# first: an existing chain cannot be re-verified with a new key.
AUDIT_CHAIN_SECRET=""

# Leave unset. Set to "true" only to run a documented chain repair
# (`npm run audit:rechain`, which needs a server started with this flag). It is
# the sole switch that allows rebuilding the log, and it is off by default.
# AUDIT_ALLOW_RECHAIN="true"

# Set to "false" only in automated test environments to skip the human check.
# Never set it in production.
HUMAN_CHECK_REQUIRED="true"

# Optional: restrict who may embed the site in a frame (CSP frame-ancestors).
# Default "https:" allows any secure embed, which is what preview panes need.
# FRAME_ANCESTORS="'self' https://portal.example.org"
